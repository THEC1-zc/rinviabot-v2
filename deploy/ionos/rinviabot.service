[Unit]
Description=Rinviabot Telegram and Google Calendar (isolated from QWE and STUDIO)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=rinviabot
Group=rinviabot
WorkingDirectory=/var/lib/rinviabot
LoadCredentialEncrypted=rinviabot.json:/etc/rinviabot/runtime.cred
ExecStart=/opt/rinviabot/venv/bin/python /opt/rinviabot/app/launch.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
StateDirectory=rinviabot
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rinviabot
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
MemoryMax=320M
CPUQuota=50%
TasksMax=64
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
